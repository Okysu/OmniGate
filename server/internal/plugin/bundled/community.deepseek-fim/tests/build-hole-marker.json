{
  "name": "构造请求：最后一条 user 消息按空缺标记拆分（多段文本拼接，system 与历史消息忽略）",
  "hook": "buildRequest",
  "secrets": { "apiKey": "sk-test" },
  "request": {
    "model": "deepseek-flash",
    "messages": [
      { "role": "system", "content": "你是代码补全助手" },
      { "role": "user", "content": "旧问题" },
      { "role": "assistant", "content": "旧回答" },
      { "role": "user", "content": [
        { "type": "text", "text": "def add(a, b):\n" },
        { "type": "image_url", "image_url": { "url": "https://example.com/a.png" } },
        { "type": "text", "text": "    <|fim_hole|>\n\nprint(add(1, 2)) # <|fim_hole|> 之后的标记保留" }
      ] }
    ]
  },
  "expect": {
    "output": {
      "url": "https://api.deepseek.com/beta/completions",
      "body": {
        "prompt": "def add(a, b):\n    ",
        "suffix": "\n\nprint(add(1, 2)) # <|fim_hole|> 之后的标记保留",
        "max_tokens": 4096,
        "stream": false
      }
    }
  }
}
