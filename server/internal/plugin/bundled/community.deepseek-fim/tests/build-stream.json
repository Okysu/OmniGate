{
  "name": "构造请求：流式（stream_options.include_usage）",
  "hook": "buildRequest",
  "secrets": { "apiKey": "sk-test" },
  "request": {
    "model": "deepseek-flash",
    "stream": true,
    "stream_options": { "include_usage": true },
    "prompt": "func main() {",
    "suffix": "}"
  },
  "expect": {
    "output": {
      "url": "https://api.deepseek.com/beta/completions",
      "headers": { "Authorization": "Bearer sk-test", "Accept": "text/event-stream" },
      "body": { "prompt": "func main() {", "suffix": "}", "stream": true, "stream_options": { "include_usage": true } }
    }
  }
}
