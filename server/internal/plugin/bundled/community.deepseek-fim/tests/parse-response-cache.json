{
  "name": "非流式响应：缓存命中（只有 prompt_cache_hit_tokens）与 length",
  "hook": "parseResponse",
  "response": {
    "status": 200,
    "body": {
      "id": "cmpl-2", "object": "text_completion", "model": "deepseek-flash",
      "choices": [{ "text": "abc", "index": 0, "finish_reason": "length" }],
      "usage": { "prompt_tokens": 1000, "completion_tokens": 16, "total_tokens": 1016, "prompt_cache_hit_tokens": 896, "prompt_cache_miss_tokens": 104 }
    }
  },
  "expect": {
    "output": {
      "choices": [{ "message": { "content": "abc" }, "finish_reason": "length" }],
      "usage": { "prompt_tokens": 1000, "completion_tokens": 16, "prompt_tokens_details": { "cached_tokens": 896 } }
    }
  }
}
