{
  "name": "Ollama 开启：reasoning_effort = 配置的强度",
  "hook": "transformRequest",
  "config": {
    "thinking": "on",
    "thinkingStyle": "ollama",
    "reasoningEffort": "low"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "qwen3:8b",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ]
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "qwen3:8b",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "reasoning_effort": "low",
        "reasoning": null
      }
    }
  }
}
