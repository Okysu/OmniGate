{
  "name": "modelRegex 不匹配时不改写",
  "hook": "transformRequest",
  "config": {
    "modelRegex": "^qwen3",
    "thinking": "off",
    "thinkingStyle": "zhipu",
    "maxTokensCap": 1024
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "llama3.1:8b",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "max_tokens": 9000
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "llama3.1:8b",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "max_tokens": 9000,
        "thinking": null
      }
    }
  }
}
