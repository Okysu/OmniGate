{
  "name": "mergeBody：对象深度合并，数组与标量替换，model / stream / messages 被忽略",
  "hook": "transformRequest",
  "config": {
    "mergeBody": "{\"options\": {\"num_ctx\": 8192, \"stop\": [\"b\"]}, \"top_k\": 20, \"model\": \"x\", \"stream\": false, \"messages\": []}"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "m",
      "stream": true,
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "options": {
        "temperature": 0.7,
        "stop": [
          "a"
        ]
      },
      "top_k": 40
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "m",
        "stream": true,
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "options": {
          "temperature": 0.7,
          "num_ctx": 8192,
          "stop": [
            "b"
          ]
        },
        "top_k": 20
      }
    }
  }
}
