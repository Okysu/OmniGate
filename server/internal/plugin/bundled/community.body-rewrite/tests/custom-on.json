{
  "name": "custom 写法：点分路径写入对象值",
  "hook": "transformRequest",
  "config": {
    "thinking": "on",
    "thinkingStyle": "custom",
    "thinkingPath": "reasoning",
    "thinkingOnValue": "{\"enabled\": true, \"max_tokens\": 2048}"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "m",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ]
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "m",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "reasoning": {
          "enabled": true,
          "max_tokens": 2048
        }
      }
    }
  }
}
