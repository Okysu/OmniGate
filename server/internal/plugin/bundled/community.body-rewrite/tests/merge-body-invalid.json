{
  "name": "mergeBody 不是 JSON 对象时忽略，其余改写照常",
  "hook": "transformRequest",
  "config": {
    "mergeBody": "{not json}",
    "maxTokensCap": 100
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "m",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "max_tokens": 9000
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "m",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "max_tokens": 100
      }
    }
  }
}
