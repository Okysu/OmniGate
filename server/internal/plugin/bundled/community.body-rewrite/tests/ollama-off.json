{
  "name": "Ollama 关闭：reasoning_effort = none（reasoning 对象同步）",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "ollama"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "qwen3:8b",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "reasoning": {
        "effort": "high"
      }
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "qwen3:8b",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "reasoning_effort": "none",
        "reasoning": {
          "effort": "none"
        }
      }
    }
  }
}
