{
  "name": "embeddings 请求不改写",
  "hook": "transformRequest",
  "config": {
    "removeFields": "dimensions",
    "mergeBody": "{\"foo\": 1}"
  },
  "request": {
    "dialect": "openai.embeddings",
    "path": "/embeddings",
    "headers": {},
    "body": {
      "model": "bge-m3",
      "input": "hi",
      "dimensions": 512
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "bge-m3",
        "input": "hi",
        "dimensions": 512,
        "foo": null
      }
    }
  }
}
