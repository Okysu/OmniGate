{
  "name": "百炼写法（Responses）：同样写顶层 enable_thinking",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "qwen_dashscope"
  },
  "request": {
    "dialect": "openai.responses",
    "path": "/responses",
    "headers": {},
    "body": {
      "model": "qwen-plus",
      "input": "hi"
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "qwen-plus",
        "input": "hi",
        "enable_thinking": false
      }
    }
  }
}
