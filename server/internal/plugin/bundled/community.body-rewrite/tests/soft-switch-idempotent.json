{
  "name": "软开关：已经带 /no_think 时不再追加",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "qwen_soft_switch"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "qwen3",
      "messages": [
        {
          "role": "user",
          "content": "问题 /no_think"
        }
      ]
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "qwen3",
        "messages": [
          {
            "role": "user",
            "content": "问题 /no_think"
          }
        ]
      }
    }
  }
}
