{
  "name": "智谱开启：thinking.type = enabled",
  "hook": "transformRequest",
  "config": {
    "thinking": "on",
    "thinkingStyle": "zhipu"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "glm-4.6",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ]
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "glm-4.6",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "thinking": {
          "type": "enabled"
        }
      }
    }
  }
}
