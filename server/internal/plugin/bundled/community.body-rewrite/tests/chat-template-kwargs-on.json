{
  "name": "chat_template_kwargs 开启",
  "hook": "transformRequest",
  "config": {
    "thinking": "on",
    "thinkingStyle": "chat_template_kwargs"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "Qwen/Qwen3-8B",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ]
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "Qwen/Qwen3-8B",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "chat_template_kwargs": {
          "enable_thinking": true,
          "thinking": true
        }
      }
    }
  }
}
