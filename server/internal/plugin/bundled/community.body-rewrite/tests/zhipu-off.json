{
  "name": "智谱关闭：thinking.type = disabled，保留其他字段",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "zhipu"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "glm-4.6",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "thinking": {
        "type": "enabled",
        "clear_thinking": false
      }
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "glm-4.6",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "thinking": {
          "type": "disabled",
          "clear_thinking": false
        }
      }
    }
  }
}
