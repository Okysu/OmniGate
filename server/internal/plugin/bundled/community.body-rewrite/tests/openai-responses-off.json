{
  "name": "openai 写法（Responses）：reasoning.effort，保留 summary",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "openai"
  },
  "request": {
    "dialect": "openai.responses",
    "path": "/responses",
    "headers": {},
    "body": {
      "model": "gpt-5.1",
      "input": "hi",
      "reasoning": {
        "summary": "auto"
      }
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "gpt-5.1",
        "input": "hi",
        "reasoning": {
          "effort": "none",
          "summary": "auto"
        },
        "reasoning_effort": null
      }
    }
  }
}
