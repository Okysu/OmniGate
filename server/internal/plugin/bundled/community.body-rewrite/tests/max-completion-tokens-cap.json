{
  "name": "输出上限：max_completion_tokens",
  "hook": "transformRequest",
  "config": {
    "maxTokensCap": 4096,
    "setMaxTokensWhenMissing": true
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "m",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "max_completion_tokens": 32000
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "m",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "max_completion_tokens": 4096,
        "max_tokens": null
      }
    }
  }
}
