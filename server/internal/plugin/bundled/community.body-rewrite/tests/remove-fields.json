{
  "name": "删除字段：顶层字段与点分路径；model / stream / messages 受保护",
  "hook": "transformRequest",
  "config": {
    "removeFields": "parallel_tool_calls，service_tier, stream_options.continuous_usage_stats\nmetadata.user_id model stream messages missing.path"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "m",
      "stream": true,
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "parallel_tool_calls": false,
      "service_tier": "auto",
      "stream_options": {
        "include_usage": true,
        "continuous_usage_stats": true
      },
      "metadata": {
        "user_id": "u1",
        "tag": "t"
      }
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "m",
        "stream": true,
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "parallel_tool_calls": null,
        "service_tier": null,
        "stream_options": {
          "include_usage": true,
          "continuous_usage_stats": null
        },
        "metadata": {
          "user_id": null,
          "tag": "t"
        }
      }
    }
  }
}
