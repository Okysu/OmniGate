{
  "name": "openai 写法（Responses）开启：默认 medium",
  "hook": "transformRequest",
  "config": {
    "thinking": "on",
    "thinkingStyle": "openai"
  },
  "request": {
    "dialect": "openai.responses",
    "path": "/responses",
    "headers": {},
    "body": {
      "model": "o4-mini",
      "input": "hi"
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "o4-mini",
        "input": "hi",
        "reasoning": {
          "effort": "medium"
        }
      }
    }
  }
}
