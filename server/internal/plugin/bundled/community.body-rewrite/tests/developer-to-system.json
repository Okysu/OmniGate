{
  "name": "developer 角色改为 system（Chat）",
  "hook": "transformRequest",
  "config": {
    "developerToSystem": true
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "m",
      "messages": [
        {
          "role": "developer",
          "content": "规则"
        },
        {
          "role": "user",
          "content": "你好"
        },
        {
          "role": "developer",
          "content": "补充"
        }
      ]
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "m",
        "messages": [
          {
            "role": "system",
            "content": "规则"
          },
          {
            "role": "user",
            "content": "你好"
          },
          {
            "role": "system",
            "content": "补充"
          }
        ]
      }
    }
  }
}
