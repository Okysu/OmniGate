{
  "name": "软开关（Responses）：字符串 input",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "qwen_soft_switch"
  },
  "request": {
    "dialect": "openai.responses",
    "path": "/responses",
    "headers": {},
    "body": {
      "model": "qwen3",
      "input": "你好"
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "qwen3",
        "input": "你好 /no_think"
      }
    }
  }
}
