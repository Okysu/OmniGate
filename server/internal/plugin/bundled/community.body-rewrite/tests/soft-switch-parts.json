{
  "name": "软开关：多段内容改最后一个文本段",
  "hook": "transformRequest",
  "config": {
    "thinking": "on",
    "thinkingStyle": "qwen_soft_switch"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "qwen3-vl",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "看图"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "data:image/png;base64,AAAA"
              }
            },
            {
              "type": "text",
              "text": "描述一下 /no_think"
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "qwen3-vl",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "看图"
              },
              {
                "type": "image_url"
              },
              {
                "type": "text",
                "text": "描述一下 /think"
              }
            ]
          }
        ]
      }
    }
  }
}
