{
  "name": "custom 写法：JSON Pointer 路径写入关闭值",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "custom",
    "thinkingPath": "/extra/enable_reasoning",
    "thinkingOnValue": "true",
    "thinkingOffValue": "false"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "m",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "extra": {
        "keep": 1
      }
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "m",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "extra": {
          "keep": 1,
          "enable_reasoning": false
        }
      }
    }
  }
}
