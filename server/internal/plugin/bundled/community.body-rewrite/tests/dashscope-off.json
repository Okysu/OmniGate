{
  "name": "百炼兼容模式关闭：enable_thinking = false",
  "hook": "transformRequest",
  "config": {
    "thinking": "off",
    "thinkingStyle": "qwen_dashscope"
  },
  "request": {
    "dialect": "openai.chat",
    "path": "/chat/completions",
    "headers": {},
    "body": {
      "model": "qwen-plus",
      "messages": [
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "enable_thinking": true
    }
  },
  "expect": {
    "output": {
      "body": {
        "model": "qwen-plus",
        "messages": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "enable_thinking": false
      }
    }
  }
}
