# 宿主机本地开发配置（make dev-server 读取）。依赖由 `make dev-deps` 启动。
# 默认使用 compose 中的 mock-oidc：登录页输入任意用户名，用户名即 sub。
OMNIGATE_ENV=development
OMNIGATE_PUBLIC_URL=http://localhost:5173
OMNIGATE_ALLOWED_ORIGINS=http://localhost:5173
OMNIGATE_DATABASE_URL=postgres://omnigate:omnigate-dev@localhost:5432/omnigate?sslmode=disable
OMNIGATE_COOKIE_SECURE=false
OMNIGATE_LOG_FORMAT=text
OMNIGATE_LOG_LEVEL=debug
OMNIGATE_REGISTRATION_MODE=open
OMNIGATE_BOOTSTRAP_ADMINS=dev:admin
OMNIGATE_AUTH_OIDC=dev
OMNIGATE_AUTH_OIDC_DEV_NAME="本地模拟 OIDC"
OMNIGATE_AUTH_OIDC_DEV_ISSUER=http://localhost:9000/default
OMNIGATE_AUTH_OIDC_DEV_CLIENT_ID=omnigate-dev
OMNIGATE_AUTH_OIDC_DEV_CLIENT_SECRET=dev-secret
# 如需在本地测试 GitHub 登录，在 GitHub OAuth App 中把回调设为
# http://localhost:5173/api/auth/github/callback 并填写：
# OMNIGATE_AUTH_GITHUB_CLIENT_ID=
# OMNIGATE_AUTH_GITHUB_CLIENT_SECRET=

# 允许渠道管理员创建指向本机/内网的渠道（本地 Ollama、内网网关等）。生产环境请谨慎开启。
OMNIGATE_CHANNELS_ALLOW_PRIVATE_NETWORK=true
