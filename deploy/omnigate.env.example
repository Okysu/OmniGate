# =====================================================================
# OmniGate 生产环境变量（gate.example.com，单实例）
#
#   cp deploy/omnigate.env.example deploy/omnigate.env && chmod 600 deploy/omnigate.env
#
# deploy/docker-compose.yml 通过 env_file 把整个文件交给 omnigate 容器。
# 写法：每行 KEY=VALUE，值不要加引号、不要在值后面写注释；值为空等同于未设置（使用默认值）。
# 每个变量的详细说明见 docs/operations/configuration.md，部署步骤见 docs/operations/deploy-production.md。
# 这里只列出 OmniGate 实际读取的变量（server/internal/config/config.go）。
#
# 生产模式（OMNIGATE_ENV=production）下，以下任一项缺失或不合规，进程会在打开数据库、执行迁移之前退出：
#   PUBLIC_URL 不是 https、缺少 MASTER_KEY、缺少 BOOTSTRAP_ADMINS、没有任何登录方式、
#   BOOTSTRAP_ADMINS 中没有一项能匹配已配置的登录方式、OIDC Issuer / GitHub 端点不是 https、
#   COOKIE_SECURE=false、SMTP_SECURITY=none。
# =====================================================================

# ---------------------------------------------------------------------
# 1. 基本
# ---------------------------------------------------------------------
OMNIGATE_ENV=production
# 用户浏览器访问的地址：只能是源（scheme://host），不能带路径和结尾的 /。
# OAuth 回调地址、CSRF 来源校验、邮件中的链接都由它决定。
OMNIGATE_PUBLIC_URL=https://gate.example.com

# ---------------------------------------------------------------------
# 2. 数据库 —— 镜像里没有数据库服务，只由这一个变量决定用哪种数据库
# ---------------------------------------------------------------------
# 方案 A：外部 PostgreSQL（云数据库或已有实例）。
# OMNIGATE_DATABASE_URL=postgres://omnigate:强密码@db.example.internal:5432/omnigate?sslmode=require
#   密码含 @ / : # 等字符时需要百分号编码（@ → %40）；数据库在宿主机本机时主机写 host.docker.internal
#   （deploy/docker-compose.yml 已配置 extra_hosts）。
#
# 方案 B：SQLite 单文件，存放在 /data 卷中，零依赖。适合个人 / 小团队、单实例、中低写入量。
#   这也是镜像的默认值（整行删掉时使用；不要写成空值 OMNIGATE_DATABASE_URL=）。
OMNIGATE_DATABASE_URL=sqlite:///data/omnigate.db
#
# 方案 C：由 Compose 顺带运行 PostgreSQL（docker compose --profile postgres up -d）。
#   在 deploy/.env 中设置 POSTGRES_PASSWORD，这里写同一个密码，主机为 postgres：
# OMNIGATE_DATABASE_URL=postgres://omnigate:与POSTGRES_PASSWORD相同@postgres:5432/omnigate?sslmode=disable
#
# 启动时自动执行数据库迁移；设为 false 时需要先手动运行 `omnigate migrate`。
# OMNIGATE_AUTO_MIGRATE=true

# 首次启动时导入价格与套餐目录（每个数据库只导入一次，之后的启动自动跳过）：
#   builtin   镜像内置的目录：8 个 GPT 模型售价（含 gpt-image-2 按张计费）、8 条模型资料、6 个套餐（Go → Elite），以 USD 计价
#   /data/x.json  自定义目录文件（格式见 deploy/seed/README.md）
#   留空      不导入（默认）
# 内置目录要求结算币种为 USD（第 6 节）；币种不一致时只记录错误日志并跳过，不影响启动。
# 数据库里已有同样的数据时只写入“已导入”标记，不会产生新的价格版本。之后升级镜像带来新目录时不会自动导入，
# 启动日志会提示；手动导入：docker compose exec omnigate omnigate seed builtin --dry-run，确认后去掉 --dry-run。
OMNIGATE_SEED_ON_START=builtin

# ---------------------------------------------------------------------
# 3. 主密钥（必填）—— 加密渠道上游 API Key、SMTP 密码等
# ---------------------------------------------------------------------
# 生成：docker run --rm ghcr.io/okysu/omnigate:latest keygen      （或在源码目录 make keygen）
# 输出形如 k20261009-a1b2c3:BASE64...，整行粘贴到等号后面。
# 务必另外备份（密码管理器），且与数据库备份分开保存：丢失主密钥 = 所有已加密的渠道凭据永久无法解密。
# 轮换：新密钥放最前面、旧密钥保留在后面，逗号分隔（docs/operations/configuration.md 第 3.2 节）。
OMNIGATE_MASTER_KEY=

# ---------------------------------------------------------------------
# 4. 登录（生产至少配置一种；OmniGate 不存储密码，只接受外部身份）
# ---------------------------------------------------------------------
# 4.1 GitHub OAuth App：https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:               https://gate.example.com
#   Authorization callback URL: https://gate.example.com/api/auth/github/callback
OMNIGATE_AUTH_GITHUB_CLIENT_ID=
OMNIGATE_AUTH_GITHUB_CLIENT_SECRET=
# GitHub Enterprise Server 才需要（必须 https）：
# OMNIGATE_AUTH_GITHUB_AUTH_URL=https://github.example.com/login/oauth/authorize
# OMNIGATE_AUTH_GITHUB_TOKEN_URL=https://github.example.com/login/oauth/access_token
# OMNIGATE_AUTH_GITHUB_API_URL=https://github.example.com/api/v3
#
# 4.2 通用 OIDC（Keycloak、Authentik、Zitadel、Google、Entra ID…），可与 GitHub 同时启用，多个用逗号分隔 ID。
#   ID 上线后不要修改（是身份的一部分）；只能用小写字母、数字、-，不能是 github / email，不能以 -id 结尾。
#   在 IdP 登记的重定向 URI：https://gate.example.com/api/auth/<id>/callback（下例为 /api/auth/sso/callback）
#   生产环境 Issuer 必须是 https，且与 IdP 发现文档中的 issuer 完全一致。
# OMNIGATE_AUTH_OIDC=sso
# OMNIGATE_AUTH_OIDC_SSO_NAME=企业 SSO
# OMNIGATE_AUTH_OIDC_SSO_ISSUER=https://id.example.com/realms/main
# OMNIGATE_AUTH_OIDC_SSO_CLIENT_ID=omnigate
# OMNIGATE_AUTH_OIDC_SSO_CLIENT_SECRET=
# OMNIGATE_AUTH_OIDC_SSO_SCOPES=openid,profile,email

# 引导管理员（必填）：这些身份首次登录即成为系统管理员（任何注册模式下都生效）。多个用逗号分隔。
#   github-id:<数字ID>   推荐，不可变。查询：curl -s https://api.github.com/users/<你的GitHub用户名> | grep '"id"'
#   <oidc-id>:<sub>      OIDC 的 sub，如 sso:248289761001
#   email:<已验证邮箱>   任意登录方式的已验证邮箱
#   github:<用户名>      不推荐：用户名可改名、被他人重新注册；生产环境使用时启动日志会警告
# 例：OMNIGATE_BOOTSTRAP_ADMINS=github-id:583231
OMNIGATE_BOOTSTRAP_ADMINS=

# 注册模式：
#   restricted（推荐上线初期）只有引导管理员、下面允许名单中的身份 / 邮箱域名可以注册
#   closed     只有已有账号能登录（新身份一律拒绝）；先用 restricted 让需要的人注册，再切到 closed
#   open       任何通过 GitHub / OIDC 认证的人都能注册（公开服务才用）
OMNIGATE_REGISTRATION_MODE=restricted
# restricted 模式下允许注册的身份（语法同上，推荐 github-id:）与已验证邮箱域名（精确匹配，不含子域名）。
# 例：OMNIGATE_AUTH_ALLOWED_IDENTITIES=github-id:1003,email:alice@example.com
OMNIGATE_AUTH_ALLOWED_IDENTITIES=
# 例：OMNIGATE_AUTH_ALLOWED_EMAIL_DOMAINS=example.com
OMNIGATE_AUTH_ALLOWED_EMAIL_DOMAINS=

# 会话：绝对有效期与空闲超时（Go 时长写法，不支持 d）。
OMNIGATE_SESSION_TTL=720h
OMNIGATE_SESSION_IDLE_TTL=168h
# 会话 Cookie 的 Secure 标志：不设置时由 PUBLIC_URL 推导（https → true）。生产环境设为 false 会拒绝启动，保持注释即可。
# OMNIGATE_COOKIE_SECURE=true

# ---------------------------------------------------------------------
# 5. 网络与反向代理
# ---------------------------------------------------------------------
# 受信任的反向代理地址：只有直连来源在此列表中时才解析 X-Forwarded-For 得到真实客户端 IP
# （用于登录限流、会话与审计日志）。只写代理的精确地址，不要写 172.16.0.0/12 这类大网段。
#   宿主机上的 Caddy / nginx 经 127.0.0.1:8080 访问（deploy/Caddyfile、deploy/nginx/）：172.30.88.1
#     即 deploy/docker-compose.yml 固定网段的网关地址，改了网段要同步修改。
#   容器版 Caddy（docker compose --profile caddy）：172.30.88.10
#   两种都可能用到时：172.30.88.1,172.30.88.10
OMNIGATE_TRUSTED_PROXIES=172.30.88.1
# 额外允许的浏览器来源（CSRF Origin 校验；PUBLIC_URL 总是允许）。同域部署无需设置。
OMNIGATE_ALLOWED_ORIGINS=
# 容器内监听地址，保持默认；compose 只把它映射到宿主机 127.0.0.1:8080。
# OMNIGATE_HTTP_ADDR=:8080
# Prometheus 指标端口：只在容器网络内可达（compose 没有发布该端口），不要对公网开放。不需要时设为 off。
OMNIGATE_METRICS_ADDR=:9090

# ---------------------------------------------------------------------
# 6. 结算币种 —— 首次启动时写入数据库并锁定，之后修改不生效
# ---------------------------------------------------------------------
# ISO 4217 三字母代码：人民币 CNY、美元 USD。上线前确定好。内置目录（OMNIGATE_SEED_ON_START=builtin）要求 USD。
OMNIGATE_CURRENCY=USD

# ---------------------------------------------------------------------
# 7. 邮件通知（SMTP）—— 可选；为空时邮件渠道不可用（站内通知照常）。也可以在后台“系统设置”中填写（数据库中的值优先）。
# ---------------------------------------------------------------------
# security：starttls（587，默认）| tls（隐式 TLS，465）。生产环境不允许 none。
OMNIGATE_SMTP_HOST=
OMNIGATE_SMTP_PORT=587
OMNIGATE_SMTP_SECURITY=starttls
OMNIGATE_SMTP_USERNAME=
OMNIGATE_SMTP_PASSWORD=
# 发件人，例：OmniGate <noreply@example.com>
OMNIGATE_SMTP_FROM=

# ---------------------------------------------------------------------
# 8. 上游渠道
# ---------------------------------------------------------------------
# 所有上游（OpenAI、Anthropic 等）请求经由的代理：http:// https:// socks5://（可带 user:pass@）。
# 服务器无法直连上游时设置；OmniGate 不读取 HTTP_PROXY / HTTPS_PROXY。
OMNIGATE_UPSTREAM_PROXY=
# 是否允许“渠道管理员”的渠道访问内网 / 本机地址（本地 Ollama 等）。默认关闭（SSRF 防护）。
OMNIGATE_CHANNELS_ALLOW_PRIVATE_NETWORK=false
# 插件内存看门狗阈值（MiB，16–8192）。
OMNIGATE_PLUGIN_HEAP_LIMIT_MB=256

# ---------------------------------------------------------------------
# 9. 数据目录、前端、日志
# ---------------------------------------------------------------------
# 本地状态目录（结算日志 settlement-journal.jsonl 等），生产默认 /data，即 compose 中的 omnigate-data 卷。
# 使用 PostgreSQL 时也需要这个卷。
# OMNIGATE_DATA_DIR=/data
# 前端页面（内嵌在二进制中）。false 时只提供 /api、/v1；WEB_DIR 用磁盘上的前端构建替代内嵌版本（如 /data/web）。
OMNIGATE_WEB_ENABLED=true
# OMNIGATE_WEB_DIR=/data/web
# 日志：json（默认，适合收集）| text；级别 debug | info | warn | error。
OMNIGATE_LOG_FORMAT=json
OMNIGATE_LOG_LEVEL=info
