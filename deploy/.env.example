# Docker Compose 自身使用的变量（插值），OmniGate 进程不读取。可选：全部有默认值。
#   cp deploy/.env.example deploy/.env
# Compose 会自动读取 docker-compose.yml 所在目录（deploy/）下的 .env。
# OmniGate 的配置写在 omnigate.env（见 omnigate.env.example），不要写在这里。

# 要开启的可选捆绑服务（逗号分隔），设置后不必每次写 --profile：
#   postgres  由 Compose 顺带运行 PostgreSQL（同时设置下面的 POSTGRES_PASSWORD，并在 omnigate.env 写连接串）
#   caddy     容器版 Caddy，自动 HTTPS（占用宿主机 80/443）
# 外部 PostgreSQL + 宿主机反向代理：保持注释。
# COMPOSE_PROFILES=caddy

# 镜像：默认 ghcr.io/okysu/omnigate:<OMNIGATE_TAG>。升级 / 回滚时只改这一行，然后 docker compose pull && docker compose up -d。
#   latest   最新正式版（v* 标签）或 main 分支的最新构建
#   0.1.0    固定版本（推荐生产使用）；也可写 0.1 跟随补丁版本
#   main     main 分支的最新构建；sha-<7位提交号> 固定到某次构建
OMNIGATE_TAG=latest
# 完整镜像名，设置后优先于 OMNIGATE_TAG（本地构建：make docker IMAGE=omnigate:local，再写 OMNIGATE_IMAGE=omnigate:local）。
# OMNIGATE_IMAGE=ghcr.io/okysu/omnigate:0.1.0

# 宿主机上供反向代理访问的端口（只绑定 127.0.0.1）。
OMNIGATE_PORT=8080

# 容器内存上限与 Go 运行时软上限（GOMEMLIMIT 约为上限的 80%）。
OMNIGATE_MEM_LIMIT=1g
OMNIGATE_GOMEMLIMIT=800MiB

# Compose 网络的前三段（默认 172.30.88 → 172.30.88.0/24，网关 .1，容器版 Caddy 固定为 .10）。
# 与本机已有网络冲突（Pool overlaps）时修改，并同步修改 omnigate.env 的 OMNIGATE_TRUSTED_PROXIES。
# OMNIGATE_SUBNET_PREFIX=172.30.88

# 仅 caddy profile：站点域名（DNS 需指向本机）。
# OMNIGATE_DOMAIN=gate.example.com

# 仅 postgres profile：PostgreSQL 密码，只用字母和数字（会拼进连接串）。
# 生成：head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9'
# 只在数据卷首次初始化时生效，之后修改不会改变数据库中的密码。
POSTGRES_PASSWORD=
