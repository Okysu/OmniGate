# ============================================================
# OmniGate 配置示例。复制为 .env 后修改；或运行 ./scripts/init-env.sh 自动生成。
# 所有变量说明见 docs/operations/configuration.md
# ============================================================

# 运行环境：development | production。production 会强制 https、Secure Cookie、主密钥与引导管理员。
# 部署到服务器请用 ./scripts/init-env.sh https://你的域名 生成，会自动设为 production。
OMNIGATE_ENV=development
# 对外访问地址（只能是源，不能带路径；用于 OAuth 回调地址与 CSRF 来源校验）
OMNIGATE_PUBLIC_URL=http://localhost:8080
# 反向代理地址（逗号分隔，CIDR 或单个 IP），用于解析 X-Forwarded-For
OMNIGATE_TRUSTED_PROXIES=
# 额外允许的浏览器来源（逗号分隔），开发时前端 Vite 地址
OMNIGATE_ALLOWED_ORIGINS=

# 主密钥：<kid>:<base64 32字节>，多个用逗号分隔，第一个为当前加密密钥。
# 生成：docker compose run --rm omnigate keygen  或  make keygen
OMNIGATE_MASTER_KEY=

# PostgreSQL 密码（compose 使用）
POSTGRES_PASSWORD=change-me

# 结算币种（ISO 4217）。首次启动后写入数据库并锁定，后续修改需要显式迁移。
OMNIGATE_CURRENCY=USD

# ---------- 登录（仅外部身份，不存储密码） ----------
# 注册模式：open（任何人）| restricted（仅允许名单）| closed（仅已有账号）
OMNIGATE_REGISTRATION_MODE=restricted
# 引导管理员：首次登录即成为系统管理员。推荐使用不可变的 github-id:<数字ID>
#   github:<login> | github-id:<id> | <oidc-id>:<sub> | email:<已验证邮箱>
OMNIGATE_BOOTSTRAP_ADMINS=
# restricted 模式下允许注册的身份与邮箱域名
OMNIGATE_AUTH_ALLOWED_IDENTITIES=
OMNIGATE_AUTH_ALLOWED_EMAIL_DOMAINS=

# GitHub OAuth App（https://github.com/settings/developers）
# 回调地址：${OMNIGATE_PUBLIC_URL}/api/auth/github/callback
OMNIGATE_AUTH_GITHUB_CLIENT_ID=
OMNIGATE_AUTH_GITHUB_CLIENT_SECRET=

# 通用 OIDC 提供方（可多个，逗号分隔 ID），回调地址：${OMNIGATE_PUBLIC_URL}/api/auth/<id>/callback
# OMNIGATE_AUTH_OIDC=corp
# OMNIGATE_AUTH_OIDC_CORP_NAME=公司 SSO
# OMNIGATE_AUTH_OIDC_CORP_ISSUER=https://id.example.com
# OMNIGATE_AUTH_OIDC_CORP_CLIENT_ID=
# OMNIGATE_AUTH_OIDC_CORP_CLIENT_SECRET=

# 会话：绝对有效期与空闲超时
OMNIGATE_SESSION_TTL=720h
OMNIGATE_SESSION_IDLE_TTL=168h

OMNIGATE_LOG_LEVEL=info
OMNIGATE_LOG_FORMAT=json

# ---------- 上游与渠道 ----------
# 允许“渠道管理员”创建指向本机/内网地址的渠道（本地 Ollama、内网网关）。默认关闭，防止 SSRF。
OMNIGATE_CHANNELS_ALLOW_PRIVATE_NETWORK=false
# 所有上游请求经由此代理（http/https/socks5）。网关不会读取 HTTP_PROXY 等环境变量。
OMNIGATE_UPSTREAM_PROXY=

# ---------- 插件 ----------
# 插件内存看门狗阈值（MB，按插件执行期间进程堆增长量计算，超过即中断执行）。
OMNIGATE_PLUGIN_HEAP_LIMIT_MB=256

# ---------- 邮件通知（SMTP，可在系统设置页覆盖） ----------
# 为空时邮件渠道不可用（站内通知照常）。security: starttls（默认）| tls（隐式 TLS，465）| none（仅开发环境）。
OMNIGATE_SMTP_HOST=
OMNIGATE_SMTP_PORT=587
OMNIGATE_SMTP_SECURITY=starttls
OMNIGATE_SMTP_USERNAME=
OMNIGATE_SMTP_PASSWORD=
# 如 OmniGate <noreply@example.com>
OMNIGATE_SMTP_FROM=
